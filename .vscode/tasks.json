{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Claude: Fix Active Script",
			"type": "shell",
			"command": "claude config set thinking false && claude \"Review and fix any syntax or logical bugs in ${relativeFile}\"",
			"problemMatcher": [
				"$prev-context"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			}
		},
		{
			"label": "Claude: Write Custom Request",
			"type": "shell",
			"command": "claude config set thinking false && claude \"${input:customPrompt} for ${relativeFile}\"",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			}
		},
		{
			"label": "Engine: Run Headless Test",
			"type": "shell",
			"command": "godot --headless -s ${relativeFile}",
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Validation: GUT (Git Bash)",
			"type": "process",
			"command": "C:\\Program Files\\Git\\bin\\bash.exe",
			"args": [
				"-lc",
				"cd \"${workspaceFolder}\" && bash scripts/run_gut_validation.sh"
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
