			"type": "process",
			"command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
			"args": [
				"-NoProfile",
				"-Command",
				"ssh vic@192.168.1.254 \"cd /data/code/project0 && printf 'remote checkout: ' && pwd && git status --short --branch\""
			],
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			}
		},
		{
			"label": "Validation: Record Sync (Git Bash)",
			"type": "process",
