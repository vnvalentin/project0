			"type": "process",
			"command": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
			"args": [
				"-NoProfile",
				"-File",
				"${workspaceFolder}\\scripts\\run_windows_experiment_1100.ps1"
