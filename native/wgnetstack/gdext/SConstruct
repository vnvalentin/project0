#!/usr/bin/env python
# Slice 034: builds the wgnetstack GDExtension, statically linking the Go
# bridge c-archive produced by `make -C .. cgoarchive`
# (../build/libwgnetstack.a). Linux only in this slice; the Windows build
# (S3b) will add its own platform branch here.

env = SConscript("godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

# Link the Go bridge c-archive (per-platform) plus the platform system libs
# the cgo/Go runtime needs, before creating the SharedLibrary target.
if env["platform"] == "linux":
    env.Append(LIBS=[File("#../build/libwgnetstack.a")])
    # cgo's c-archive output needs pthread, dl, and libm at link time.
    env.Append(LIBS=["pthread", "dl", "m"])
elif env["platform"] == "windows":
    env.Append(LIBS=[File("#../build/libwgnetstack.windows.a")])
    # Windows system libs the Go runtime, net stack, and crypto/rand need.
    env.Append(LIBS=["ws2_32", "winmm", "ntdll", "bcrypt", "iphlpapi", "userenv", "psapi", "advapi32"])

library = env.SharedLibrary(
    "build/libwgnetstack_gdext{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)

env.NoCache(library)
Default(library)
