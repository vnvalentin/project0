{
  "dirs": [
    "res://tests/unit/",
    "res://tests/integration/"
  ],
  "include_subdirs": true,
  "should_exit": true,
  "should_exit_on_success": true,
  "log_level": 1,
  "hide_orphans": false,
  "ignore_pause": true,
  "double_strategy": "script_only",
  "disable_colors": false,
  "compact_mode": true
}
