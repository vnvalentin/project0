# Godot 4 Core Ignores
.godot/
*.import
export_presets.cfg

# Build & Deployment Ignores
build/
dist/
*.log

# Python bytecode (dashboard tooling)
__pycache__/
*.pyc

# Slice 007 multi-peer smoke test scratch state (cleaned up on normal exit;
# ignored as a safety net if a run is interrupted before cleanup runs)
.test_multi_peer_state_*.json

# Binary Asset Quarantine (Hidden from AI scanning)
assets/models/
assets/textures/
assets/audio/
*.glb
*.gltf
*.png
*.wav
*.ogg

# Native wgnetstack module: vendored deps, venvs, and compiled artifacts (Slices 032/034)
native/**/.venv/
native/**/godot-cpp/
native/**/*.o
native/**/*.a
*.so
*.dll
*.dylib