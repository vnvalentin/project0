# Copy to /etc/project0/operator.env on the Linux host and set permissions to 600.
# The operator token is a shared secret; treat it like a password.
OPERATOR_TOKEN=replace-with-a-long-random-operator-token
OPERATOR_BIND_HOST=127.0.0.1
OPERATOR_BIND_PORT=8099
# Durable append-only audit DB (survives restarts). Default lives under
# infra/operator/.data/; in production point it at a host data volume.
OPERATOR_AUDIT_DB_PATH=/var/lib/project0/operator/audit.sqlite3
