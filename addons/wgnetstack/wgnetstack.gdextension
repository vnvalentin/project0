linux.release.x86_64 = "res://native/wgnetstack/gdext/build/libwgnetstack_gdext.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://native/wgnetstack/gdext/build/libwgnetstack_gdext.windows.template_debug.x86_64.dll"
