# Shared assertion secret for the Project0 login/game split (Slice 071).
#
# Install to /etc/project0/assertion.env on the Linux host and set permissions
# to 600. BOTH project0-server.service (validator) and project0-login.service
# (issuer) load this SAME file — the game server can only validate the login
# server's session assertions when both processes share this one HMAC secret.
#
# Generate a fresh 32-byte (64 hex char) secret with:
#   openssl rand -hex 32
# Treat it like a password: rotating it invalidates in-flight assertions.
PROJECT0_ASSERTION_SECRET=replace-with-64-hex-characters-from-openssl-rand-hex-32
