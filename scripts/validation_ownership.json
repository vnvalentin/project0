{
  "schema_version": 1,
  "hosts": {
    "linux": ["192.168.1.254", "github-actions-linux"],
    "windows": ["SETSUJOKU", "github-actions-windows"]
  },
  "test_roots": ["tests", "scripts", "infra", "dashboard", "operator_console", "native"],
  "server_data_exceptions": ["server/starting_town_hub_fixture.gd"],
  "server_dependencies": ["sqlite", "canon", "ollama"],
  "suites": {
    "godot-server": {
      "platform": "linux",
      "owner": "linux-server",
      "dependencies": ["godot", "sqlite"],
      "runner": "scripts/run_gut_validation.sh",
      "tests": ["tests/unit/test_*.gd", "tests/integration/test_*.gd", "scripts/test_*.gd", "scripts/paired_server_fixture.gd"],
      "evidence": "supporting-headless"
    },
    "linux-services": {
      "platform": "linux",
      "owner": "linux-server",
      "dependencies": ["python", "sqlite"],
      "runner": "python -m pytest infra/enrollment/tests infra/operator/tests dashboard/tests operator_console/tests",
      "tests": ["infra/*/tests/test_*.py", "dashboard/tests/test_*.py", "operator_console/tests/test_*.py"],
      "evidence": "supporting-component"
    },
    "linux-tooling": {
      "platform": "linux",
      "owner": "linux-tooling",
      "dependencies": ["python"],
      "runner": "python scripts/test_validation_ownership.py",
      "tests": ["scripts/test_*.py"],
      "evidence": "supporting-component"
    },
    "linux-shell": {
      "platform": "linux",
      "owner": "linux-tooling",
      "dependencies": ["bash"],
      "runner": "bash <selected shell test>",
      "tests": ["scripts/test_*.sh"],
      "evidence": "supporting-component"
    },
    "windows-fixture": {
      "platform": "windows",
      "owner": "windows-tooling",
      "dependencies": ["go"],
      "runner": "go test scripts/generate_1100_fixture.go scripts/generate_1100_fixture_test.go",
      "tests": ["scripts/*_test.go"],
      "evidence": "supporting-component"
    },
    "windows-client": {
      "platform": "windows",
      "owner": "windows-client",
      "dependencies": ["godot-client", "powershell"],
      "runner": "Windows owner selects an approved standalone package or client-only harness",
      "tests": ["scripts/test_*.ps1", "scripts/check_windows_client_package.ps1", "scripts/verify_standalone_package.ps1", "scripts/run_paired_validation.ps1", "scripts/windows_paired_client.gd", "scripts/client_package_inventory.gd", "tests/fixtures/windows_client_packages.gd"],
      "evidence": "client-only-not-server-proof"
    },
    "windows-launcher": {
      "platform": "windows",
      "owner": "windows-launcher",
      "dependencies": ["go", "powershell"],
      "runner": "scripts/run_windows_launcher_validation.ps1",
      "tests": ["native/windows_launcher/*_test.go"],
      "evidence": "launcher-only-not-gameplay-proof"
    }
  }
}