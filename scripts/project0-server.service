# See docs/slices/003-lan-client-connection.md for the LAN-bind rationale.
[Unit]
Description=Project0 Godot headless authoritative game server (LAN)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vic
WorkingDirectory=/data/code/project0
# Binds the ENet/UDP server to the LAN IP so remote LAN clients can reach it.
# If create_server() fails because the interface is not up yet at boot, the
# process exits non-zero and systemd restarts it until the LAN IP is ready.
ExecStart=/usr/local/bin/godot --headless --path /data/code/project0 -s server/server_main.gd -- --server-bind-address=192.168.1.254
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
