{
  "//": "Registry of deployable Project0 services (Slice 104). Adding a new service to CD is one entry here; scripts/deploy_all.sh needs no change. Health is what proves a deploy, so every entry must define one.",
  "version": 1,
  "deploy_root": "/data/code/project0",
  "backup_root": "/data/code",
  "services": [
    {
      "name": "game-server",
      "kind": "systemd",
      "unit": "project0-server.service",
      "required": true,
      "source_check": "server/server_main.gd",
      "health": {
        "kind": "systemd-active",
        "unit": "project0-server.service"
      }
    },
    {
      "name": "login-server",
      "kind": "systemd",
      "unit": "project0-login.service",
      "required": true,
      "source_check": "server/login_server_main.gd",
      "health": {
        "kind": "health-file",
        "path": "/var/lib/project0/login/health.json",
        "max_age_seconds": 60
      }
    },
    {
      "name": "enrollment",
      "kind": "systemd",
      "unit": "project0-enrollment.service",
      "required": true,
      "source_check": "infra/enrollment/asgi.py",
      "venv": ".venv-enrollment",
      "requirements": "infra/enrollment/requirements.txt",
      "health": {
        "kind": "http",
        "url": "http://192.168.1.254:8095/healthz",
        "expect_status": 200
      }
    },
    {
      "name": "operator",
      "kind": "systemd",
      "unit": "project0-operator.service",
      "//required": "false because the unit is not installed on the host yet; deploy reports it as skipped rather than failing the run.",
      "required": false,
      "source_check": "infra/operator/asgi.py",
      "venv": ".venv-enrollment",
      "requirements": "infra/operator/requirements.txt",
      "health": {
        "kind": "http",
        "url": "http://127.0.0.1:8099/healthz",
        "expect_status": 200
      }
    },
    {
      "name": "dashboard",
      "kind": "compose",
      "compose_file": "dashboard/docker-compose.yml",
      "required": false,
      "source_check": "dashboard/app.py",
      "health": {
        "kind": "compose-running",
        "compose_file": "dashboard/docker-compose.yml"
      }
    }
  ]
}
